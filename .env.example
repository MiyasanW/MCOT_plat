DEBUG=False
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# บน production ที่มี HTTPS ใส่ SECURE_SSL_REDIRECT=true; รัน runserver ในเครื่องไม่ต้องใส่
# SECURE_SSL_REDIRECT=true

# DB (PostgreSQL)
# DB_NAME=mcot_rental_db
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Gmail SMTP — ส่งให้ลูกค้า (ใบเสนอราคา, แจ้งเตือน) ใช้ App Password เท่านั้น
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=MCOT Rental <your-email@gmail.com>

# ลิงก์ในอีเมล (รีเซ็ตรหัสผ่าน ฯลฯ) — รัน local ใช้ 127.0.0.1:8000 แล้วรัน: python manage.py set_site_domain
# SITE_DOMAIN=127.0.0.1:8000

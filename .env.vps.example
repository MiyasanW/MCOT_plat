# VPS Environment Configuration Template
# Copy this to .env on the VPS and fill in the actual values
# THIS FILE IS FOR VPS PRODUCTION USE ONLY

# ============================================================================
# DJANGO CORE
# ============================================================================
DEBUG=False
SECRET_KEY=change-me-to-random-string-at-least-50-chars-use-django-insecure-secret
ALLOWED_HOSTS=mcotequipmentservices.mcot.net,www.mcotequipmentservices.mcot.net

# ============================================================================
# DATABASE — PostgreSQL (REQUIRED FOR VPS)
# ============================================================================
# Format: postgresql://username:password@host:port/database
# Replace with your actual credentials from VPS PostgreSQL setup
DATABASE_URL=postgresql://mcot_user:your_strong_password_123@127.0.0.1:5432/mcot_rental_db

# Note: Do NOT use DATABASES_URL (legacy format, deprecated)
# Always use DATABASE_URL for new deployments

# ============================================================================
# SECURITY (Production)
# ============================================================================
# Only set to true if you have SSL certificate (Let's Encrypt recommended)
SECURE_SSL_REDIRECT=true

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================================================
# Use Gmail App Password (16 chars with spaces), NOT your main Gmail password
# Generate at: https://myaccount.google.com/apppasswords

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=MCOT Equipment Service <your-email@gmail.com>

# ============================================================================
# SITE DOMAIN (For email links, password reset tokens)
# ============================================================================
# Must match the production domain
SITE_DOMAIN=mcotequipmentservices.mcot.net

# ============================================================================
# OPTIONAL: Additional Tuning
# ============================================================================
# Cache timeout for availability checks (seconds)
# CACHE_TIMEOUT=300

# Maximum booking duration (days)
# MAX_RENTAL_DAYS=30

# ============================================================================
# NOTES FOR VPS SETUP
# ============================================================================
# 1. Create PostgreSQL database before using this file:
#    sudo -u postgres psql
#    CREATE DATABASE mcot_rental_db;
#    CREATE USER mcot_user WITH PASSWORD 'strong_password';
#    GRANT ALL PRIVILEGES ON DATABASE mcot_rental_db TO mcot_user;
#    \q
#
# 2. Fill in actual values for:
#    - DATABASE_URL (PostgreSQL credentials)
#    - EMAIL_HOST_USER (Gmail address)
#    - EMAIL_HOST_PASSWORD (Gmail App Password)
#    - SECRET_KEY (use: python3 -c "import secrets; print(secrets.token_urlsafe(50))")
#    - SITE_DOMAIN (your production domain)
#
# 3. After creating .env, run:
#    python3 manage.py migrate
#    python3 manage.py collectstatic --noinput
#    sudo systemctl restart gunicorn
#
# 4. Verify setup:
#    python3 manage.py check --deploy
